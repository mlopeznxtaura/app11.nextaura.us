# Optional — app11 runs CPU-only with no secrets required for the GUI.
# Copy to .env for local dev only; never commit real values.

PUBLIC_HOST=localhost
PUBLIC_URL=http://localhost:8080
TRAIN_DEVICE=cpu
HEADLESS=1

# Hugging Face (only needed for streaming datasets, HF import, distill-live)
HF_TOKEN=

# IBM COS checkpoint sync (optional — leave blank for local-only checkpoints)
IBM_CLOUD_API_KEY=
COS_CRN=
COS_BUCKET=
COS_ENDPOINT=

# UpCloud / S3-compatible archive (optional)
UPCLOUD_S3_ACCESS_KEY=
UPCLOUD_S3_SECRET_KEY=
UPCLOUD_S3_ENDPOINT=
UPCLOUD_S3_BUCKET=
UPCLOUD_S3_PREFIX=checkpoints/
